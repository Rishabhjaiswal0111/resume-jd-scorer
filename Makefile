# Run from the repo root inside WSL/Linux/macOS.
SHELL := /bin/bash
.DEFAULT_GOAL := help

BACKEND  := backend
FRONTEND := frontend
UV       := uv --directory $(BACKEND)
PNPM     := pnpm --dir $(FRONTEND)

.PHONY: help setup up down nuke logs ps migrate revision dev-api dev-web \
        lint format typecheck test test-api test-web check gen-api clean \
        seed-prices score start stop pending demo timings

help: ## Show this help
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-12s\033[0m %s\n",$$1,$$2}'

# ---------- setup ----------
setup: ## Install all dependencies and git hooks
	@test -f .env || (cp .env.example .env && echo "Created .env from .env.example")
	$(UV) sync
	$(PNPM) install
	$(UV) run pre-commit install --config ../.pre-commit-config.yaml

# ---------- infrastructure ----------
up: ## Start Postgres and wait until healthy (MinIO is opt-in: compose profile "s3")
	docker compose --env-file .env up -d --wait postgres

down: ## Stop Docker services (keeps data)
	docker compose down

nuke: ## Stop Docker services AND delete their data volumes
	docker compose down -v

logs: ## Tail Docker service logs
	docker compose logs -f

ps: ## Show Docker service status
	docker compose ps

# ---------- database ----------
migrate: ## Apply all migrations
	$(UV) run alembic upgrade head

revision: ## New autogenerated migration: make revision m="message"
	@test -n "$(m)" || (echo 'Usage: make revision m="message"' && exit 1)
	$(UV) run alembic revision --autogenerate -m "$(m)"

seed-prices: ## Load the current price for LLM_DEFAULT_MODEL into model_prices
	$(UV) run python -m app.cli prices sync

score: ## Score a pair from the CLI: make score jd=path/jd.pdf resume=path/resume.pdf
	@test -n "$(jd)" -a -n "$(resume)" || (echo 'Usage: make score jd=JD.pdf resume=RESUME.pdf' && exit 1)
	$(UV) run python -m app.cli score $(abspath $(jd)) $(abspath $(resume))

demo: ## Create/refresh the demo account (demo@jdscorer.app / demo1234): make demo [reset=1]
	$(UV) run python -m app.cli demo $(if $(reset),--reset,)

timings: ## How long each stage takes (extraction, JD parse, scoring, queue, search): make timings [days=30]
	@$(UV) run python -m app.cli timings --days $(or $(days),30) 2>/dev/null

# ---------- run the app ----------
start: ## Start everything (Docker, Postgres, migrations, API, web), wait until ready, open the browser
	@scripts/start.sh

stop: ## Stop what `make start` started (API, web, Postgres); data is kept
	@scripts/stop.sh

pending: ## Manual LLM mode: list prompts waiting for an answer file
	@scripts/pending.sh

# ---------- dev servers ----------
dev-api: ## Run API with auto-reload on :8000
	$(UV) run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

dev-web: ## Run frontend dev server on :5173
	$(PNPM) dev

# ---------- quality ----------
lint: ## Lint backend + frontend
	$(UV) run ruff check .
	$(UV) run ruff format --check .
	$(PNPM) lint
	$(PNPM) format:check

format: ## Auto-format backend + frontend
	$(UV) run ruff check --fix .
	$(UV) run ruff format .
	$(PNPM) format

typecheck: ## Type-check backend + frontend
	$(UV) run mypy app
	$(PNPM) typecheck

test-api: ## Backend tests
	$(UV) run pytest

test-web: ## Frontend tests
	$(PNPM) test

test: test-api test-web ## All tests

check: lint typecheck test ## Everything CI runs

gen-api: ## Regenerate frontend API types from the backend OpenAPI schema
	$(UV) run python -m app.scripts.export_openapi ../$(FRONTEND)/openapi.json
	$(PNPM) gen:api

clean: ## Remove caches and build output
	rm -rf $(BACKEND)/.pytest_cache $(BACKEND)/.mypy_cache $(BACKEND)/.ruff_cache $(FRONTEND)/dist
