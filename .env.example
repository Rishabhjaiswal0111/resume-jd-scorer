# Copy to .env and fill in. Never commit .env.

# --- app ---
APP_ENV=dev                      # dev | test | staging | prod
LOG_LEVEL=INFO
LOG_JSON=false                   # true in staging/prod (machine-readable logs)
CORS_ORIGINS=http://localhost:5173

# --- database (matches docker-compose.yml) ---
POSTGRES_USER=jdscorer
POSTGRES_PASSWORD=jdscorer_dev_password
POSTGRES_DB=jdscorer
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jdscorer:jdscorer_dev_password@localhost:5432/jdscorer

# --- file storage ---
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_ROOT=./var/storage

# --- MinIO (S3-compatible, used when STORAGE_BACKEND=s3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=jd-scorer
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password

# --- LLM (Phase 1) ---
# "<provider>/<model>": anthropic/claude-haiku-5-5 or openrouter/deepseek/deepseek-v4.1-flash
LLM_DEFAULT_MODEL=anthropic/claude-haiku-5-5
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
LLM_CACHE_ENABLED=true
OPENROUTER_DATA_COLLECTION=deny  # deny = never route resumes to providers that keep prompts
ANTHROPIC_API_KEY=                # console.anthropic.com (not a Claude.ai subscription)
LLM_EFFORT=medium                 # Claude thinking depth: low | medium | high
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
